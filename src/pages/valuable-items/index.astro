---
import ValuableItemsGrid from '../../components/ValuableItemsGrid.vue';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadStaticJson } from '../../services/loadStaticJson';

type SpecialDrop = {
	id: string;
	typeId: string;
	name: { zhTw: string; en: string };
	itemUrl: string;
	dropArea: string;
	boss: string;
	valueLabel: string;
	acquisition: {
		summary: string;
		detail?: { title: string; html: string };
	};
};

type SpecialDropData = {
	title: string;
	scope: { checkedAt: string; priceNote: string };
	source: { name: string; url: string };
	types: Array<{ id: string; label: string }>;
	items: SpecialDrop[];
};

const specialDrops = await loadStaticJson<SpecialDropData>('special-high-value-drops.json');
---

<BaseLayout title="高價值物品｜POE2 新手筆記" bodyClass="valuable-items-body">
	<main class="relative overflow-x-clip pb-12 text-stone-100">
		<div class="global-px-box">
			<header class="atlas-motion-hero base-container pt-8 md:pt-12">
				<h1 class="atlas-page-title font-english-body text-3xl font-bold text-stone-100 md:text-5xl">高價值物品</h1>
			</header>
		</div>

		<div class="global-px-box">
			<section id="valuable-items-content" class="atlas-scroll-reveal base-container py-8 md:py-12">
				<ValuableItemsGrid initialData={specialDrops} client:load />
			</section>
		</div>
	</main>
</BaseLayout>
