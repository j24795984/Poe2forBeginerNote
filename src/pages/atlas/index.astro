---
import AtlasCategoryTabs from '../../components/AtlasCategoryTabs.vue';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="輿圖｜POE2 新手筆記" bodyClass="atlas-body">
	<main class="relative overflow-x-clip pb-12 text-stone-100">
		<div class="global-px-box">
			<header class="atlas-motion-hero base-container pt-8 md:pt-12">
				<h1 class="atlas-page-title font-english-body text-3xl font-bold text-stone-100 md:text-5xl">輿圖 - 目標與明</h1>
			</header>
		</div>

		<div class="global-px-box">
			<section id="atlas-content" class="atlas-scroll-reveal base-container py-8 md:py-12">
				<AtlasCategoryTabs client:load />
			</section>
		</div>

		<div class="global-px-box">
			<footer id="atlas-scope" class="atlas-scroll-reveal atlas-accent-border-15 base-container border-t py-10">
				<div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
					<p class="max-w-xl text-sm leading-7 text-stone-400">本頁內容依據本專案維護的 `atlas.json` 顯示；尚未整理的分類會明確標示為待補內容。</p>
					<a class="atlas-accent-link font-english-body text-sm font-semibold tracking-[0.14em] transition" href={`${base}`}>回到起點</a>
				</div>
			</footer>
		</div>
	</main>
</BaseLayout>
