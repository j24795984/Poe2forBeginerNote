---
import BuildsCategoryTabs from '../../components/BuildsCategoryTabs.vue';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="拓荒與流派｜POE2 新手筆記" bodyClass="builds-body">
	<main class="relative overflow-x-clip pb-12 text-stone-100">
		<div class="global-px-box">
			<header class="atlas-motion-hero base-container pt-8 md:pt-12">
				<h1 class="atlas-page-title font-english-body text-3xl font-bold text-stone-100 md:text-5xl">拓荒與流派</h1>
			</header>
		</div>

		<div class="global-px-box">
			<section id="builds-content" class="atlas-scroll-reveal base-container py-8 md:py-12">
				<BuildsCategoryTabs client:load />
			</section>
		</div>
	</main>
</BaseLayout>
