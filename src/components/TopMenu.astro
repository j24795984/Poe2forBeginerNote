---
const base = import.meta.env.BASE_URL;
const primaryLinks = [
	{ href: 'builds/', label: '拓荒與流派' },
	{ href: 'campaign/', label: '主線' },
	{ href: 'atlas/', label: '輿圖' },
	{ href: 'farming/', label: '賺錢' },
	{ href: 'crafting/', label: '做裝' },
	{ href: 'valuable-items/', label: '高價值物品' },
];
const utilityLinks = [
	{ href: 'tools/', label: '工具' },
	{ href: 'settings/', label: '設定' },
];
---

	<div class="top-menu-spacer" data-top-menu-spacer aria-hidden="true"></div>
	<nav class="top-menu" data-top-menu aria-label="主要導覽">
		<div class="global-px-box py-5">
			<div class="base-container">
				<div class="top-menu-glass flex w-full items-center gap-3 px-6 py-3">
					<a class="top-menu-brand font-english-body text-sm font-semibold transition" href={base}>
						<img class="top-menu-logo" src={`${base}images/logo.webp`} width="48" height="48" alt="" />
						POE2 BEGINNER NOTE
					</a>

					<div class="top-menu-actions ml-auto flex items-center gap-1">
						<div class="top-menu-primary-links items-center">
							{primaryLinks.map(({ href, label }) => <a class="top-menu-link" href={`${base}${href}`}>{label}</a>)}
						</div>

						<details class="top-menu-more">
							<summary class="top-menu-toggle" aria-label="開啟更多導覽選項">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
							</summary>
							<div class="top-menu-dropdown">
								<div class="top-menu-mobile-links">
									{primaryLinks.map(({ href, label }) => <a class="top-menu-link" href={`${base}${href}`}>{label}</a>)}
								</div>
								{utilityLinks.map(({ href, label }) => <a class="top-menu-link" href={`${base}${href}`}>{label}</a>)}
							</div>
						</details>
					</div>
				</div>
			</div>
		</div>
	</nav>

	<script>
		import { initializeTopMenu } from '../scripts/topMenu';
		initializeTopMenu({
			menu: document.querySelector<HTMLElement>('[data-top-menu]'),
			spacer: document.querySelector<HTMLElement>('[data-top-menu-spacer]'),
		});
	</script>
