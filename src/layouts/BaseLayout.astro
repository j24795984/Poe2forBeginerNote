---
import '../styles/style.css';
import TopMenu from '../components/TopMenu.astro';

interface Props { title: string; bodyClass?: string; }
const { title, bodyClass } = Astro.props;
const imageBase = `${import.meta.env.BASE_URL}images/`;
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Lobster+Two:wght@400;700&family=Noto+Sans+TC:wght@100..900&family=Ramabhadra&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
		<script is:inline src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
		<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
		<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js"></script>
		<link rel="stylesheet" href="https://unpkg.com/lenis@1.3.25/dist/lenis.css" />
		<script is:inline src="https://unpkg.com/lenis@1.3.25/dist/lenis.min.js"></script>
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32x32.png`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-icon-180x180.png`} />
		<link rel="icon" type="image/png" sizes="192x192" href={`${import.meta.env.BASE_URL}android-icon-192x192.png`} />
		<script>
			import { initializeSiteShell } from '../scripts/siteShell';
			initializeSiteShell({
				scrollbar: document.querySelector<HTMLElement>('.site-scrollbar'),
				thumb: document.querySelector<HTMLElement>('.site-scrollbar-thumb'),
			});
		</script>
		<title>{title}</title>
	</head>
	<body class:list={['site-body', bodyClass]}>
		<div class="site-page">
			<picture class="site-background" aria-hidden="true">
				<source media="(max-width: 767px)" srcset={`${imageBase}poe2-mobile-767x1364-cropped.webp`} />
				<source media="(max-width: 1439px)" srcset={`${imageBase}poe2-hero-1280x653.webp`} />
				<img class="site-background-image h-lvh w-full object-cover" src={`${imageBase}poe2-hero-1920x980.webp`} alt="" />
			</picture>
			<div class="site-background-overlay" aria-hidden="true"></div>
			<div class="site-content">
				<TopMenu />
				<slot />
			</div>
		</div>
		<div class="site-scrollbar" aria-hidden="true"><div class="site-scrollbar-thumb"></div></div>
	</body>
</html>
