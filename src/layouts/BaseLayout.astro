---
interface Props { title: string; }
const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Path of Exile 2 新手筆記" />
		<title>{title}</title>
		<!-- Tailwind browser CDN is for development; switch to a build integration before production. -->
		<script is:inline src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css" />
		<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
		<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
		<style is:inline>:root { color-scheme: dark; } body { margin: 0; min-width: 320px; background: #020617; }</style>
	</head>
	<body><slot /></body>
</html>
