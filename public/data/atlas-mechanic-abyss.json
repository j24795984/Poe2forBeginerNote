    { "id": "abyss-guide-source-005", "label": "POE2DB－深淵之怒", "url": "https://poe2db.tw/tw/Abyssal_Ire" },
    { "id": "abyss-guide-source-006", "label": "POE2DB－褻瀆詞綴", "url": "https://poe2db.tw/tw/Desecrated_Modifiers" },
